# ==========================================
# RAG System Environment Variables
# ==========================================

# 1. API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LLM Settings
# Supported providers: 'openai', 'google_genai'
LLM_PROVIDER=openai
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Gemini models: gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# 3. Embeddings Settings
# Supported providers: 'openai', 'google_genai'
EMBEDDING_PROVIDER=openai
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Gemini: models/text-embedding-004, models/gemini-embedding-001
EMBEDDING_MODEL_NAME=text-embedding-3-small

# 4. Text Splitting / Chunking Settings
# Strategy options: 'recursive', 'character', 'semantic'
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 5. Vector Database Settings (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_collection
RETRIEVER_TOP_K=4
